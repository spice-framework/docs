---
import LanguageSelect from "@astrojs/starlight/components/LanguageSelect.astro";
import SiteTitle from "@astrojs/starlight/components/SiteTitle.astro";
import SocialIcons from "@astrojs/starlight/components/SocialIcons.astro";
import ThemeSelect from "@astrojs/starlight/components/ThemeSelect.astro";
import ProductSwitcher from "../ProductSwitcher.astro";
import SpicePalette from "../SpicePalette.astro";
import Search from "./Search.astro";
---

<div class="spice-header">
  <div class="spice-header__brand"><SiteTitle /></div>
  <ProductSwitcher />
  <div class="spice-header__search"><Search /></div>
  <div class="spice-header__actions">
    <SocialIcons />
    <ThemeSelect />
    <LanguageSelect />
  </div>
</div>
<SpicePalette />

<script>
  import "../../scripts/spice-code-viewer.ts";
</script>

<style>
  .spice-header {
    align-items: center;
    display: grid;
    gap: clamp(0.6rem, 1.4vw, 1.3rem);
    grid-template-columns: auto auto minmax(10rem, 1fr) auto;
    height: 100%;
  }
  .spice-header__brand,
  .spice-header__actions {
    align-items: center;
    display: flex;
  }
  .spice-header__brand {
    min-width: 0;
  }
  .spice-header__actions {
    gap: 0.65rem;
  }
  @media (max-width: 50rem) {
    .spice-header {
      grid-template-columns: auto auto 1fr;
    }
    .spice-header__search {
      justify-self: end;
    }
    .spice-header__actions {
      display: none;
    }
  }
</style>
