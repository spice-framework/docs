---
import DefaultHead from "@astrojs/starlight/components/Head.astro";

const image = new URL("/og-image.png", Astro.site);
---

<DefaultHead />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#e20114" />
<meta property="og:type" content="website" />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Spice Framework — valid Go in, ordinary Go out" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={image} />
