{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@docs/contract": ["packages/docs-contract/src/index.ts"],
      "@docs/assembler": ["packages/source-assembler/src/index.ts"],
      "@docs/spice-code": ["packages/expressive-code-spice/src/index.ts"]
    },
    "types": ["node", "vitest/globals"]
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules", ".generated/sources"]
}
